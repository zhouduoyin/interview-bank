# 复制为 .env.local 后按需修改；.env.local 已被 git 忽略。
# 前端请求前缀：Nginx / Vite 代理保持 /api；直连后端可改为 http://127.0.0.1:8090/api
VITE_API_BASE_URL=/api

# 仅 Vite 开发服务器使用：本地 Spring Boot 地址
VITE_PROXY_TARGET=http://127.0.0.1:8090

# 开发/预览端口
VITE_DEV_PORT=5173
VITE_PREVIEW_PORT=4173

# 需要局域网访问时改为 0.0.0.0
VITE_DEV_HOST=127.0.0.1

# npm run dev 端口被占用时是否直接失败；默认 false，会自动换端口
VITE_STRICT_PORT=false

# 部署到子路径时修改，例如 /interview/
VITE_PUBLIC_BASE=/

# 生产构建默认关闭 sourcemap；需要时改为 true
VITE_BUILD_SOURCEMAP=false
